<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ★★ 这份清单刻意保持「最小」—— 只声明活不下去就没法工作的一条权限，
         外加一个 Application 子类。原因是排查「点开即闪退、连弹窗都没有」
         时定位到的一类问题：

         进程起来的顺序其实是
             ① 系统读 manifest
             ② 解析 networkSecurityConfig   ← 在我们代码之前
             ③ 初始化所有 ContentProvider   ← 在我们代码之前
             ④ Application 构造 / attachBaseContext
             ⑤ Application.onCreate()        ← 我们最早能装崩溃处理器的地方
             ⑥ Activity.onCreate()

         ②③ 两步里任何异常都会让进程在 ⑤ 之前直接死掉：
         崩溃处理器还没装，用户看到的就是「闪一下就没了，什么提示都没有」，
         连我们辛苦写的诊断弹窗都没机会出现。

         所以：
           · 不写 networkSecurityConfig（②），只用 usesCleartextTraffic
           · 不引任何 androidx 依赖（③ 那批 ContentProvider 全是 androidx 带来的）
           · Application 里只做毫秒级的事（⑤ 不长时间占主线程）
    -->

    <!-- 只连本机 127.0.0.1，不出网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 读写 /sdcard 下的游戏目录与存档 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--
      安卓 11+ 需要「所有文件访问权限」才能读 /sdcard/Android/data/...。
      参考 APK 也声明了同一条，说明这是这类工具的通行做法。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      ★ 本工具不需要摄像头 / 定位 / 通讯录 / 后台服务 —— 一条都不声明。
        少一条权限，隐私审查就少一条顾虑。
        注意：**不要**学参考 APK 那样申请 REQUEST_INSTALL_PACKAGES
        （装其他 APK 用），我们只处理游戏文件，不需要。
    -->

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!--
          单任务 + 不重建：WebView 里的 Python 服务不该被系统随手回收重建，
          否则用户切个后台回来就得再等一次启动。

          不锁竖屏：留一个以后可能用得上的口子（平板/折叠屏），
          也可以避免某些 ROM 对固定方向的历史包袱。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
